{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corvid:connector-manifest/1",
  "title": "Corvid connector manifest, version 1",
  "description": "Data only. The shape is checked here; validateManifest in manifest.ts also rejects code, secret values, wildcard hosts without broad, and manifests over 64 KB. See docs/CONNECTORS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "version", "description", "runtime", "config", "secrets", "capabilities", "limits"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "runtime": { "enum": ["ssh", "http", "postgres", "mysql", "mssql", "sqlite"] },
    "broad": { "type": "boolean" },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "label": { "type": "string", "maxLength": 80 },
          "type": { "enum": ["string", "number", "boolean", "host", "path"] },
          "required": { "type": "boolean" },
          "default": { "type": ["string", "number", "boolean"] },
          "description": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "label": { "type": "string", "maxLength": 80 },
          "type": { "enum": ["password", "passphrase", "token", "key", "certificate"] },
          "optional": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "operations"],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": { "type": "string" },
              "hostFrom": { "$ref": "#/$defs/key" },
              "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
              "portFrom": { "$ref": "#/$defs/key" },
              "scheme": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]{0,15}$" },
              "database": { "type": "string" }
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "class"],
            "properties": {
              "name": { "$ref": "#/$defs/key" },
              "description": { "type": "string", "maxLength": 500 },
              "class": { "enum": ["read", "write", "admin"] },
              "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] },
              "path": { "type": "string", "pattern": "^/" },
              "statements": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z ]{2,30}$" } },
              "classifier": { "enum": ["ssh-command"] },
              "input": { "$ref": "#/$defs/schema" },
              "output": { "$ref": "#/$defs/schema" }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxResponseBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "ratePerMinute": { "type": "integer", "minimum": 1, "maximum": 6000 },
        "maxUploadBytes": { "type": "integer", "minimum": 1, "maximum": 52428800 }
      }
    },
    "scrub": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fields": { "type": "array", "items": { "type": "string", "maxLength": 100 } } }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "operation"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "operation": { "$ref": "#/$defs/key" },
          "args": { "type": "object" },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "ok": { "type": "boolean" }, "contains": { "type": "string" } }
          },
          "mock": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "status": { "type": "integer", "minimum": 100, "maximum": 599 }, "body": {}, "contentType": { "type": "string", "maxLength": 100 } }
          }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "object", "array", "null"] },
        "description": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/schema" } },
        "required": { "type": "array", "items": { "type": "string" } },
        "items": { "$ref": "#/$defs/schema" },
        "enum": { "type": "array", "items": { "type": ["string", "number"] } },
        "maxLength": { "type": "integer" },
        "maximum": { "type": "number" },
        "minimum": { "type": "number" }
      }
    }
  }
}
