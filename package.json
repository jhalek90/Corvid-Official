{
  "name": "corvid",
  "version": "0.2.0",
  "description": "A desktop home for your Claude Code agents: hand them tasks, watch them work, and talk to them on one board.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhalek90/Corvid-Official.git"
  },
  "homepage": "https://github.com/jhalek90/Corvid-Official#readme",
  "bugs": {
    "url": "https://github.com/jhalek90/Corvid-Official/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/ev.mjs dev",
    "build": "node scripts/ev.mjs build",
    "start": "node scripts/ev.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/make-icons.mjs",
    "dist": "node scripts/ev.mjs build && electron-builder --win --dir",
    "package-check": "node scripts/package-check.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test": "node scripts/run-tests.mjs",
    "test-instance": "node scripts/test-instance.mjs",
    "docs:lint": "node scripts/docs-lint.mjs",
    "docs:manifest": "node scripts/docs-manifest.mjs",
    "test-docs": "node --test scripts/test-docs.mjs",
    "test-docs-view": "node --test scripts/test-docs-view.mjs",
    "test-board-render": "node scripts/board-render-check.mjs",
    "test-guards": "node --test scripts/test-guards.mjs",
    "test-agent-pings": "node --test scripts/test-agent-pings.mjs",
    "test-board-limits": "node --test scripts/test-board-limits.mjs",
    "test-discussion": "node --test scripts/test-discussion.mjs",
    "test-connectors": "node --test scripts/test-connectors.mjs",
    "test-security": "node --test scripts/test-security.mjs",
    "test-deny-platforms": "node --test scripts/test-deny-platforms.mjs",
    "test-connections-tab": "node --test scripts/test-connections-tab.mjs",
    "test-http": "node --test scripts/test-http.mjs",
    "test-db": "node --test scripts/test-db.mjs",
    "test-drafts": "node --test scripts/test-drafts.mjs",
    "test-usage-limit": "node --test scripts/test-usage-limit.mjs",
    "test-send-request": "node --test scripts/test-send-request.mjs",
    "test-paging": "node --test scripts/test-paging.mjs",
    "test-extensions": "node --test scripts/test-extensions.mjs",
    "test-packager": "node --test scripts/test-packager.mjs",
    "test-extension-scan": "node --test scripts/test-extension-scan.mjs",
    "test-sockets": "node --test scripts/test-sockets.mjs",
    "test-theme-socket": "node --test scripts/test-theme-socket.mjs",
    "test-cost": "node --test scripts/test-cost.mjs",
    "test-diff-scan": "node --test scripts/test-diff-scan.mjs",
    "test-install": "node --test scripts/test-install.mjs",
    "test-verify": "node --test scripts/test-verify.mjs",
    "test-build-progress": "node --test scripts/test-build-progress.mjs",
    "test-lifecycle": "node --test scripts/test-lifecycle.mjs",
    "test-resolve": "node --test scripts/test-resolve.mjs",
    "test-claude-lookup": "node --test scripts/test-claude-lookup.mjs",
    "test-claude-path": "node --test scripts/test-claude-path.mjs",
    "test-extension-page": "node --test scripts/test-extension-page.mjs",
    "test-task-from-message": "node --test scripts/test-task-from-message.mjs",
    "test-welcome": "node --test scripts/test-welcome.mjs",
    "test-voice-platform": "node --test scripts/test-voice-platform.mjs",
    "test-task-model": "node --test scripts/test-task-model.mjs",
    "test-custom-models": "node --test scripts/test-custom-models.mjs",
    "test-model-watch": "node --test scripts/test-model-watch.mjs",
    "test-card-model": "node --test scripts/test-card-model.mjs",
    "test-card-line": "node --test scripts/test-card-line.mjs",
    "test-effort": "node --test scripts/test-effort.mjs",
    "test-task-done": "node --test scripts/test-task-done.mjs",
    "test-auto-start": "node --test scripts/test-auto-start.mjs",
    "test-corvid-thesis": "node --test scripts/test-corvid-thesis.mjs",
    "test-corvid-context": "node --test scripts/test-corvid-context.mjs",
    "test-worker-prompt": "node --test scripts/test-worker-prompt.mjs",
    "test-lineage": "node --test scripts/test-lineage.mjs",
    "postinstall": "node scripts/electron-binary.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "secret-scan": "node scripts/secret-scan.mjs --history",
    "test-secret-scan": "node --test scripts/test-secret-scan.mjs",
    "publish-sync": "node scripts/publish-sync.mjs",
    "test-publish-sync": "node --test scripts/test-publish-sync.mjs",
    "test-board-format": "node --test scripts/test-board-format.mjs",
    "test-pty-close": "node --test scripts/test-pty-close.mjs",
    "test-pty-close-posix": "node --test scripts/test-pty-close-posix.mjs",
    "test-linux-check": "node --test scripts/test-linux-check.mjs",
    "test-board-channels": "node --test scripts/test-board-channels.mjs",
    "test-board-attachments": "node --test scripts/test-board-attachments.mjs",
    "test-task-files": "node --test scripts/test-task-files.mjs",
    "test-setup": "node --test scripts/test-setup.mjs",
    "test-electron-binary": "node --test scripts/test-electron-binary.mjs",
    "test-update-check": "node --test scripts/test-update-check.mjs",
    "test-platform": "node --test scripts/test-platform.mjs",
    "test-linux-desktop": "node --test scripts/test-linux-desktop.mjs",
    "test-paths": "node --test scripts/test-paths.mjs",
    "test-deploy": "node --test scripts/test-deploy.mjs",
    "test-keyring": "node --test scripts/test-keyring.mjs",
    "test-keys": "node --test scripts/test-keys.mjs",
    "test-launch": "node --test scripts/test-launch.mjs",
    "test-upload": "node --test scripts/test-upload.mjs",
    "test-window-platform": "node --test scripts/test-window-platform.mjs"
  },
  "author": "Justin Halek",
  "license": "FSL-1.1-ALv2",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "tedious": "^19.2.2",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "productName": "Corvid",
  "private": true,
  "build": {
    "appId": "dev.local.claude-dashboard",
    "productName": "Corvid",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!**/connections*.json",
      "!**/secrets*",
      "!**/*.pem",
      "!**/*.ppk",
      "!**/id_rsa*",
      "!**/id_dsa*",
      "!**/id_ecdsa*",
      "!**/id_ed25519*",
      "!**/known_hosts",
      "!**/.env*",
      "!**/profile/avatar*"
    ],
    "asarUnpack": [
      "resources/**",
      "node_modules/@lydell/**"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": "dir"
    },
    "mac": {
      "icon": "resources/icon-1024.png",
      "target": "dir",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": "dir",
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
